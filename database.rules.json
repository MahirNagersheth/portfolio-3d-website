{
  "rules": {
    ".read": false,
    ".write": false,
    "portfolio-friends-v1": {
      "asteroids": {
        ".read": true,
        ".write": "auth != null && auth.token.email == 'mnagersh@andrew.cmu.edu' && auth.token.email_verified == true",
        ".indexOn": ["timestamp"],
        "$asteroid": {
          ".validate": "newData.hasChildren(['name', 'emoji', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 25"
          },
          "emoji": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "timestamp": {
            ".validate": "newData.isNumber()"
          },
          "$other": { ".validate": false }
        }
      },
      "pending": {
        ".read": "auth != null && auth.token.email == 'mnagersh@andrew.cmu.edu' && auth.token.email_verified == true",
        "$entry": {
          ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.token.email == 'mnagersh@andrew.cmu.edu' && auth.token.email_verified == true)",
          ".validate": "newData.hasChildren(['name', 'emoji', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 25"
          },
          "emoji": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
