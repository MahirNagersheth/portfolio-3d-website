{
  "rules": {
    ".read": false,
    ".write": false,
    "portfolio-friends-v1": {
      "asteroids": {
        ".read": true,
        ".indexOn": ["timestamp"],
        "$asteroid": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['name', 'emoji', 'timestamp'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 25"
          },
          "emoji": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "message": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "timestamp": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000 && newData.val() >= now - 600000"
          },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
